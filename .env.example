# ──────────────────────────────────────────────
# Polymarket BTC Bayesian Bot — Environment
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# ── Trading mode ──────────────────────────────
# paper | live  (default: paper)
TRADING_MODE=paper

# ── Polymarket ────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_FUNDER=

# ── Binance ───────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_WS=wss://fstream.binance.com/ws
BINANCE_FUTURES_REST=https://fapi.binance.com

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ── Bankroll & Risk ──────────────────────────
INITIAL_BANKROLL=1000.0
MAX_FRACTION_PER_TRADE=0.05
MAX_DAILY_LOSS=100.0
MAX_OPEN_EXPOSURE=300.0
MAX_CONCURRENT_MARKETS=4
MIN_EDGE_THRESHOLD=0.04
MIN_ORDER_SIZE=1.0

# ── Signal lookbacks (seconds) ────────────────
VWAP_LOOKBACK_SHORT=30
VWAP_LOOKBACK_MEDIUM=60
VWAP_LOOKBACK_LONG=180
FUNDING_LOOKBACK_PERIODS=48
RVOL_BUCKET_MINUTES=5

# ── Macro veto (minutes) ─────────────────────
MACRO_VETO_BEFORE_MINUTES=30
MACRO_VETO_AFTER_MINUTES=30

# ── Execution ─────────────────────────────────
EXECUTION_STYLE=passive_limit
STALE_ORDER_TIMEOUT_SECONDS=30
FEE_RATE=0.002

# ── Calibration ──────────────────────────────
CALIBRATION_ARTIFACT_DIR=data/artifacts

# ── GUI ───────────────────────────────────────
GUI_REFRESH_INTERVAL_MS=1000

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log
